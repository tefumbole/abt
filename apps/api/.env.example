# AlphaBridge API — Hostinger MySQL
PORT=3003
NODE_ENV=production
CORS_ORIGIN=https://alpha-bridge.net
APP_URL=https://alpha-bridge.net
JWT_SECRET=change_this_to_a_long_random_string

# Hostinger MySQL (hPanel → Databases → MySQL)
# Use Remote MySQL hostname from Hostinger, NOT localhost, when API runs on VPS
DB_HOST=srvXXXX.hstgr.io
DB_PORT=3306
DB_USER=u123456789_abt
DB_PASSWORD=your_mysql_password
DB_NAME=u123456789_alphabridge

# Wasender (server-side — move keys here during migration)
WASENDER_API_KEY=
WASENDER_BASE_URL=https://wasenderapi.com/api
COMPANY_NAME=Alpha Bridge Technologies

# SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SEED_ADMIN_EMAIL=admin@alpha-bridge.net
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=system
SEED_ADMIN_PHONE=+237675321739
SEED_ADMIN_FORCE_PASSWORD=false

# PawaPay (Rwanda MoMo — token lives on the server only, never commit the JWT)
PAWAPAY_API_TOKEN=
PAWAPAY_ENVIRONMENT=production
PAWAPAY_TOKEN_ID=
PAWAPAY_CHECKOUT_CALLBACK_URL=https://alpha-bridge.net/api/payments/pawapay/checkouts/callback
PAWAPAY_DEPOSIT_CALLBACK_URL=https://alpha-bridge.net/api/payments/pawapay/deposits/callback
PAWAPAY_PAYOUT_CALLBACK_URL=https://alpha-bridge.net/api/payments/pawapay/payouts/callback
PAWAPAY_REFUND_CALLBACK_URL=https://alpha-bridge.net/api/payments/pawapay/refunds/callback

# Stripe (secret lives on the server only — never commit the live key)
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=RWF
